# Clave de API de Resend (https://resend.com/api-keys). Solo se lee en la Server Action de contacto.
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto.
# Con el remitente por defecto (onboarding@resend.dev), Resend solo permite enviar
# al correo de la cuenta de Resend: usa ese mismo correo aquí mientras no tengas un dominio propio verificado.
CONTACT_TO_EMAIL=

# Remitente del correo de contacto. Opcional: si se deja vacío se usa
# "Arcade E1230 <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

SUPABASE_PASSWORD= 

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=