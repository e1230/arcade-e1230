# Clave de API de Resend (https://resend.com/api-keys). Solo se lee en la Server Action de contacto.
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto.
# Con el remitente por defecto (onboarding@resend.dev), Resend solo permite enviar
# al correo de la cuenta de Resend: usa ese mismo correo aquí mientras no tengas un dominio propio verificado.
CONTACT_TO_EMAIL=

# Remitente del correo de contacto. Opcional: si se deja vacío se usa
# "Arcade E1230 <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

# URL del proyecto de Supabase (panel de Supabase → Project Settings → API, o `get_project_url` del MCP).
# Formato: https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable del proyecto (sb_publishable_…), en Project Settings → API Keys o `get_publishable_keys` del MCP.
# Es pública por diseño: va en el bundle del navegador y la protección de los datos la dan las políticas RLS.
# Nunca pongas aquí la clave secreta (sb_secret_…) ni la antigua service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
